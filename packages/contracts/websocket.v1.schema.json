{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "welcome"
        },
        "selfPlayerId": {
          "type": "string",
          "minLength": 1
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/player"
          }
        },
        "layout": {
          "$ref": "#/$defs/layout"
        }
      },
      "required": [
        "type",
        "selfPlayerId",
        "tick",
        "players",
        "layout"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "input"
        },
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "dx": {
          "enum": [
            -1,
            0,
            1
          ]
        },
        "dy": {
          "enum": [
            -1,
            0,
            1
          ]
        }
      },
      "required": [
        "type",
        "seq",
        "dx",
        "dy"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "players"
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "players": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/player"
          }
        }
      },
      "required": [
        "type",
        "tick",
        "players"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "layout.updated"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placement"
          }
        }
      },
      "required": [
        "type",
        "revision",
        "placements"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "player": {
      "type": "object",
      "properties": {
        "playerId": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "playerId",
        "displayName",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "itemId": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "itemId",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placement"
          }
        }
      },
      "required": [
        "revision",
        "placements"
      ],
      "additionalProperties": false
    }
  }
}
